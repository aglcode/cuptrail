# Copy to .env and fill in real values. Never commit .env.
# All three are needed at build time as well as at runtime.

# Neon connection string. Use the POOLED one (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Clerk: Dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"

# Optional. "true" replaces sign-in with the "Request early access" alert.
# Set it for Production only in Vercel; leave it unset for normal sign-in.
# NEXT_PUBLIC_EARLY_ACCESS="true"
