// Prisma 7: the connection string lives in prisma7.config.ts — do not add `url` here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Identity lives in Clerk; this row is synced just-in-time by getUser() (src/lib/auth.ts).
model User {
  id            String    @id // Clerk user ID (user_…)
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  visits     Visit[]
  ratings    Rating[]
  follows    Follow[] @relation("Follower")
  followedBy Follow[] @relation("Following")
}

model Shop {
  id              String    @id @default(cuid())
  slug            String    @unique // public URL key: /shops/[slug]
  name            String
  neighborhood    String
  address         String
  description     String
  category        String
  latitude        Float
  longitude       Float
  amenities       Amenity[]
  priceLevel      Int? // 1-4
  photoUrl        String?
  journalPhotoUrl String?
  wifiMbps        Int? // null = unknown, 0 = no Wi-Fi
  atmosphere      String? // e.g. "Serene study"
  outletsNote     String?
  roast           String?
  hours           String?
  specialty       String?
  mapX            Float? // pin position (%) on the illustrated neighborhood map
  mapY            Float?
  editorialRank   Int? // "Our picks" order; unranked shops sort after ranked ones

  // Denormalized from Rating so lists can filter/sort by rating without aggregating
  // per request. Only src/server/ratings/actions.ts writes these.
  ratingSum   Int   @default(0)
  ratingCount Int   @default(0)
  ratingAvg   Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits  Visit[]
  ratings Rating[]

  @@index([latitude, longitude])
  @@index([neighborhood])
  @@index([ratingAvg])
  @@index([amenities], type: Gin)
}

model Visit {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  note      String?
  visitedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId, visitedAt(sort: Desc)]) // a user's journal, newest first
  @@index([shopId])
}

model Rating {
  id         String     @id @default(cuid())
  userId     String
  shopId     String
  stars      Int // 1-5
  comment    String?
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId]) // one rating per user per shop
  @@index([shopId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId]) // "who follows X"; the unique index already covers followerId
}

// Keep in sync with the Amenity type in src/types and amenityOptions in src/lib/amenities.ts.
enum Amenity {
  wifi
  outlets
  quiet
  outdoor
  light
  tables
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}
